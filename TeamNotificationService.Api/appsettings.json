{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DB_CONNECTION_STRING (string)"
  },
  "Auth": {
    "InternalJwt": {
      "Issuer": "YOUR_INTERNAL_JWT_ISSUER (string)",
      "Audience": "YOUR_INTERNAL_JWT_AUDIENCE (string)",
      "PublicKeyPemPath": "YOUR_INTERNAL_JWT_PUBLIC_KEY_PEM_PATH(string)"
    }
  },
  "Email": {
    "Host": "YOUR_EMAIL_HOST (string)",
    "Port": "YOUR_EMAIL_PORT (int)",
    "Username": "YOUR_EMAIL_USERNAME (string)",
    "Password": "YOUR_EMAIL_PASSWORD (string)",
    "DefaultFromEmail": "YOUR_EMAIL_DEFAULT_FROM_EMAIL (string)",
    "DefaultFromName": "YOUR_EMAIL_DEFAULT_FROM_NAME (string)",
    "UseSsl": "YOUR_EMAIL_USE_SSL (bool)",
    "QueueCapacity": "YOUR_EMAIL_QUEUE_CAPACITY (int)"
  },
  "RabbitMq": {
    "Host": "YOUR_RABBITMQ_HOST (string)",
    "Port": "YOUR_RABBITMQ_PORT (int)",
    "Username": "YOUR_RABBITMQ_USERNAME (string)",
    "Password": "YOUR_RABBITMQ_PASSWORD (string)",
    "VirtualHost": "YOUR_RABBITMQ_VIRTUAL_HOST (string)",

    "Retry": {
      "AttemptHeader": "x-retry-attempt",
      "Exchange": "team.notification.retry",
      "ReturnExchange": "team.notification.retry.return",
      "DeadLetterExchange": "team.notification.dlx",
      "Delays": [
        {
          "Name": "10s",
          "MessageTtlMilliseconds": 10000
        },
        {
          "Name": "1m",
          "MessageTtlMilliseconds": 60000
        },
        {
          "Name": "10m",
          "MessageTtlMilliseconds": 600000
        }
      ]
    },

    "Consumers": {
      "NotificationRequested": {
        "Queue": "team.notification.business-events.q",
        "PrefetchCount": 10,
        "ReconnectDelaySeconds": 5,
        "Bindings": [
          {
            "Exchange": "team.organization.events",
            "ExchangeType": "topic",
            "RoutingKeys": ["user.created.v1"]
          }
        ]
      }
    },

    "Publishers": {
      "NotificationEvents": {
        "Exchange": "team.notification.events",
        "ExchangeType": "topic"
      },

      "EmailEvents": {
        "Exchange": "team.notification.email.events",
        "ExchangeType": "topic"
      }
    }
  },
  "RateLimiter": {
    "Default": {
      "TokenLimit": 200,
      "TokensPerPeriod": 100,
      "ReplenishmentPeriod": "00:00:10",
      "QueueLimit": 0
    }
  }
}
